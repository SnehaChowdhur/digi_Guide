{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NOVA: Frontend dev server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": ".*", "file": 1, "location": 2, "message": 3 }],
        "background": { "activeOnStart": true, "beginsPattern": "ready|started", "endsPattern": "ready|started" }
      },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "NOVA: Backend dev server",
      "type": "shell",
      "command": "python -m uvicorn backend.app.main:app --reload --port 8000",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
